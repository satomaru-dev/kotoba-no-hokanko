{
  "name": "contextual-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contextual memory MCP service and Kotoba no Hokan-ko mobile PWA",
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/http.ts",
    "dev:web": "vite",
    "start": "node dist/src/http.js",
    "mcp:stdio": "node dist/src/stdio.js",
    "migrate": "tsx src/migrate.ts",
    "sync": "tsx src/sync.ts",
    "sync:daemon": "tsx src/sync-daemon.ts",
    "cloud:import": "tsx src/cloud-import.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@supabase/supabase-js": "^2.57.4",
    "express": "^5.1.0",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
