# Service
PORT=8787
MEMORY_API_TOKEN=replace-with-a-long-random-secret
MEMORY_MIN_CONFIDENCE=0.52
MEMORY_MAX_RESULTS=3

# Production storage and embeddings
DATABASE_URL=postgresql://user:password@host:5432/contextual_memory
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local fallback, used when DATABASE_URL is absent
MEMORY_FILE_PATH=.data/memories.json
CAPTURE_FILE_PATH=.data/captures.json

# Local Obsidian / OneDrive source
OBSIDIAN_ROOT=C:\Users\your-name\OneDrive\保管庫
OBSIDIAN_INCLUDE=Preferences/**,Knowledge/**,*.md
OBSIDIAN_EXCLUDE=**/.env,**/*password*,**/*パスワード*,**/顧客/**,**/契約/**,**/金融/**

# Optional direct Notion sync. Share only the intended pages with this integration.
NOTION_TOKEN=
NOTION_ROOT_PAGE_IDS=

# Optional direct Google Drive sync. Use OAuth credentials for a dedicated app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_IDS=

# Optional connector snapshot (JSONL) for sources read through Codex connectors.
CONNECTOR_SNAPSHOT_PATH=.data/connector-snapshot.jsonl

# Shared cloud memory API (Supabase Edge Function)
CLOUD_MEMORY_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/memory-api
CLOUD_MEMORY_SERVICE_TOKEN=

# PWA build values (put these in web/.env.local for local development)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
